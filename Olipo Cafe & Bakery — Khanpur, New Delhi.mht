:root { --background: 42 42% 94%; --foreground: 150 20% 18%; --card: 42 38% 97%; --card-foreground: 150 20% 18%; --popover: 42 38% 97%; --popover-foreground: 150 20% 18%; --primary: 150 26% 24%; --primary-foreground: 42 42% 94%; --secondary: 38 35% 85%; --secondary-foreground: 150 20% 18%; --muted: 39 25% 87%; --muted-foreground: 150 8% 42%; --accent: 8 60% 55%; --accent-foreground: 42 42% 94%; --destructive: 0 67% 46%; --destructive-foreground: 42 42% 94%; --border: 37 21% 78%; --input: 37 21% 78%; --ring: 150 26% 24%; --radius: 1rem; --app-font-sans: 'DM Sans', sans-serif; --app-font-serif: 'Playfair Display', Georgia, serif; --app-font-mono: 'DM Sans', sans-serif; --font-sans: var(--app-font-sans); --font-serif: var(--app-font-serif); }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; scroll-padding-top: 90px; }

body { margin: 0px; color: hsl(var(--foreground)); background: hsl(var(--background)); font-family: var(--app-font-sans); -webkit-font-smoothing: antialiased; }

::selection { background: rgb(217, 155, 128); color: rgb(35, 61, 49); }

a { text-decoration: none; }

button { font: inherit; }

.grain::after { content: ""; position: fixed; inset: 0px; z-index: 40; pointer-events: none; opacity: 0.12; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.13'/%3E%3C/svg%3E"); }

.serif { font-family: var(--app-font-serif); }

.eyebrow { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; }

.site-nav { background: rgba(244, 241, 232, 0.82); backdrop-filter: blur(16px); }

.hero-image { background-image: linear-gradient(90deg, rgba(27, 43, 35, 0.44), rgba(27, 43, 35, 0.03) 80%), url("/olipo-cafe/olipo-interior.jpg"); background-size: cover; background-position: center center; }

.perspective { perspective: 1300px; }

.hero-card { transform: rotateY(-5deg) rotateX(1.4deg); transform-style: preserve-3d; }

.float-card { box-shadow: rgba(32, 45, 36, 0.18) 0px 26px 60px, rgba(32, 45, 36, 0.09) 0px 6px 16px; }

.menu-photo { background-image: linear-gradient(rgba(20, 34, 27, 0.02), rgba(20, 34, 27, 0.28)), url("/olipo-cafe/olipo-interior.jpg"); background-size: cover; }

.menu-photo.pizza { background-position: 79% center; }

.menu-photo.pasta { background-position: 60% center; filter: saturate(0.8); }

.menu-photo.waffle { background-position: 45% center; filter: sepia(0.18) saturate(0.85); }

.menu-photo.coffee { background-position: 30% center; filter: brightness(0.82) saturate(0.8); }

.ornament { border: 1px solid rgba(35, 61, 49, 0.24); }

.story-glow { background: radial-gradient(at 74% 48%, rgba(208, 151, 115, 0.28), transparent 48%); }

.offer-card { background: rgb(216, 155, 126); }

.marquee { animation: 26s linear 0s infinite normal none running marquee; }

@keyframes marquee { 
  100% { transform: translateX(-50%); }
}

.reveal { animation: 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0s 1 normal both running enter; }

.reveal-delay { animation-delay: 0.16s; }

.reveal-delay-2 { animation-delay: 0.28s; }

@keyframes enter { 
  0% { opacity: 0; transform: translateY(20px); }
  100% { opacity: 1; transform: translateY(0px); }
}

.soft-hover { transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.35s; }

.soft-hover:hover { transform: translateY(-5px) rotateX(1deg); box-shadow: rgba(35, 61, 49, 0.14) 0px 22px 38px; }

.mobile-menu { animation: 0.22s ease-out 0s 1 normal both running enter; }

.map-panel { background-color: rgb(223, 221, 209); background-image: linear-gradient(31deg, transparent 47%, rgba(255, 255, 255, 0.74) 48%, rgba(255, 255, 255, 0.74) 52%, transparent 53%), linear-gradient(123deg, transparent 47%, rgba(255, 255, 255, 0.64) 48%, rgba(255, 255, 255, 0.64) 52%, transparent 53%), linear-gradient(90deg, rgba(88, 112, 89, 0.11) 1px, transparent 1px), linear-gradient(rgba(88, 112, 89, 0.11) 1px, transparent 1px); background-size: 210px 160px, 260px 180px, 44px 44px, 44px 44px; }

@media (max-width: 767px) {
  .hero-image { background-position: 61% center; }
  .hero-card { transform: none; }
  .grain::after { opacity: 0.08; }
}

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after { scroll-behavior: auto !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
}

.film-stage { isolation: isolate; transform-style: preserve-3d; perspective: 1300px; }

.film-screen { transform: rotateY(var(--tilt-y, 0deg)) rotateX(var(--tilt-x, 0deg)); transform-style: preserve-3d; transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1); box-shadow: rgba(12, 27, 19, 0.33) 0px 38px 95px, rgba(12, 27, 19, 0.2) 0px 12px 28px; }

.film-screen::after { content: ""; position: absolute; inset: 0px; pointer-events: none; z-index: 20; background: linear-gradient(115deg, rgba(255, 255, 255, 0.13), transparent 31%, transparent 70%, rgba(255, 255, 255, 0.07)); mix-blend-mode: screen; }

.film-photo { background-image: url("/olipo-cafe/olipo-interior.jpg"); background-size: cover; }

.film-shot { animation: 0.68s cubic-bezier(0.2, 0.7, 0.2, 1) 0s 1 normal both running film-arrive; }

.film-ring { transform: translateZ(60px); box-shadow: rgba(244, 241, 232, 0.14) 0px 0px 0px 1px, rgba(244, 241, 232, 0.08) 0px 0px 22px inset, rgba(0, 0, 0, 0.14) 0px 16px 42px; }

.film-control { backdrop-filter: blur(14px); }

.film-progress { transition: width 0.1s linear; }

.film-caption { text-shadow: rgba(15, 29, 21, 0.35) 0px 1px 18px; }

@keyframes film-arrive { 
  0% { opacity: 0.4; transform: translateY(12px) scale(0.985); }
  100% { opacity: 1; transform: translateY(0px) scale(1); }
}

@keyframes slow-breathe { 
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.035); }
}

.slow-breathe { animation: 8s ease-in-out 0s infinite normal none running slow-breathe; }

@media (max-width: 767px) {
  .film-screen { transform: none; }
}

@media (prefers-reduced-motion: reduce) {
  .film-shot, .slow-breathe { animation: auto ease 0s 1 normal none running none !important; }
  .film-screen { transition: none; }
}

